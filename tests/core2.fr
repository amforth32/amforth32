T{ 8 8 naligned -> 8 }T

TESTING invert, not

T{ 0 invert -> -1 }T
T{ 1 invert -> -2 }T
T{ -1 invert -> 0 }T
T{ -2 invert -> 1 }T

T{ 0 not -> -1 }T
T{ 1 not -> 0 }T
T{ -1 not -> 0 }T

TESTING 2rot
T{ 1 2 3 4 5 6 2rot -> 3 4 5 6 1 2 }T

TESTING search

T{ : s1 S" abcdefghijklmnopqrstuvwxyz"   ; -> }T
T{ : s2 S" abc"   ; -> }T
T{ : s3 S" jklmn" ; -> }T
T{ : s4 S" z"     ; -> }T
T{ : s5 S" mnoq"  ; -> }T
T{ : s6 S" 12345" ; -> }T
T{ : s7 S" "      ; -> }T
T{ : s8 S" xyz"      ; -> }T

T{ s1 s2 SEARCH -> s1 TRUE  }T
T{ s1 s3 SEARCH -> s1  9 /STRING TRUE  }T
T{ s1 s4 SEARCH -> s1 #25 /STRING TRUE  }T
T{ s1 s5 SEARCH -> s1 FALSE }T
T{ s1 s6 SEARCH -> s1 FALSE }T
T{ s1 s7 SEARCH -> s1 TRUE  }T
T{ s1 2 - s8 SEARCH -> s1 2 - FALSE  }T

TESTING sift

T{ s2 s1 SIFT -> s1 TRUE  }T
T{ s6 s1 SIFT -> s6 FALSE }T
T{ s3 s1 SIFT -> s1 9 /STRING TRUE }T

TESTING compare, cscan, cskip

T{ s" one" s" one" compare -> false }T
T{ s" one" s" two" compare -> true }T

T{ s" one" bl cskip s" one" compare -> false }T
T{ s"    one" bl cskip s" one" compare -> false }T

T{ s" one two" bl cscan s" one" compare -> false }T
T{ s"  one" bl cscan nip 0= -> true }T

TESTING catch/throw

: t1 9 ;
: c1 1 2 3 ['] t1 CATCH ;
T{ c1 -> 1 2 3 9 0 }T    \ No THROW executed

: t2 8 0 THROW ;
: c2 1 2 ['] t2 CATCH ;
T{ c2 -> 1 2 8 0 }T    \ 0 THROW does nothing

: t3 7 8 9 99 THROW ;
: c3 1 2 ['] t3 CATCH ;
T{ c3 -> 1 2 99 }T    \ Restores stack to CATCH depth

: t4 1- DUP 0> IF RECURSE ELSE 999 THROW -222 THEN ;
: c4 3 4 5 10 ['] t4 CATCH -111 ;
T{ c4 -> 3 4 5 0 999 -111 }T        \ Test return stack unwinding

: t5 2DROP 2DROP 9999 THROW ;
: c5 1 2 3 4 ['] t5 CATCH           \ Test depth restored correctly
   DEPTH >R DROP 2DROP 2DROP R> ;    \ after stack has been emptied
T{ c5 -> 5 }T

TESTING leave stack

T{ 5 >l l@ l> -> 5 5 }T
T{ 1 2 2>l 2l@ 2l> -> 1 2 1 2 }T
T{ ldepth 1 >l ldepth ldrop ldepth -> 0 1 0 }T

decimal